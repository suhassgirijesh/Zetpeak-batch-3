# CiniKraft Backend Environment Variables

# ==============================================
# REQUIRED: Hugging Face API Token
# ==============================================
# Get your token from: https://huggingface.co/settings/tokens
# Create a token with "Read" access
HF_TOKEN=hf_your_huggingface_token_here

# ==============================================
# OPTIONAL: Additional AI Providers
# ==============================================
# Uncomment and add keys if you want to use these providers

# OpenAI DALL-E (Premium quality)
# Get key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-key-here

# Stability AI (High quality images)
# Get key from: https://platform.stability.ai/account/keys
# STABILITY_API_KEY=sk-your-stability-key-here

# Replicate (Multiple models)
# Get key from: https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=r8_your-replicate-token-here

# ==============================================
# DEVELOPMENT SETTINGS
# ==============================================
# Django secret key (auto-generated, but you can set your own)
# SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
# DEBUG=True

# Allowed hosts (comma-separated)
# ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================
# DATABASE (Optional - if using PostgreSQL instead of SQLite)
# ==============================================
# DB_NAME=cinikraft
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_HOST=localhost
# DB_PORT=5432

# ==============================================
# INSTRUCTIONS
# ==============================================
# 1. Copy this file and rename it to .env (without .example)
# 2. Fill in at least the HF_TOKEN (required)
# 3. Add other API keys as needed
# 4. Never commit the .env file to version control!
